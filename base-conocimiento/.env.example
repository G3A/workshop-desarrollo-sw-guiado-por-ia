# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# Todos los valores tienen un default razonable: el producto arranca sin tocar nada.

# ---------------------------------------------------------------------------
# Rutas en disco
# ---------------------------------------------------------------------------
# Donde vive TODO lo pesado y persistente: los GGUF del LLM y de los embeddings,
# el build de llama.cpp, datos de Postgres y el ONNX del reranker. Por defecto queda junto al repo, o sea en D:.
# Esto mantiene C: libre sin depender de configuracion del host.
KB_DATA_DIR=./.data

# El vault: una sola carpeta, FUERA del repositorio, con todo el contenido a
# ingerir. Se monta de solo lectura. Dos subcarpetas fijas debajo de esta raiz
# (crealas si no existen):
#   vault/documentos  -- Markdown, texto, PDF, DOCX, PPTX (estos tres ultimos
#                         via docling-serve, ADR-0010)
#   vault/repos       -- repositorios Git locales a indexar
KB_VAULT_DIR=../../vault

# ---------------------------------------------------------------------------
# Ingesta (F8)
# ---------------------------------------------------------------------------
# Cada cuanto se releva sola KB_CORPUS_DIR/KB_REPOS_DIR/Teams/Azure DevOps, sin
# correr ningun comando. 900000 = 15 min, razonable en uso real. Para ver el
# efecto en un taller/demo, usa un valor bajo -- p. ej. 15000 (15 s):
#   KB_INGESTA_RELEVO_INTERVALO_MS=15000
KB_INGESTA_RELEVO_INTERVALO_MS=900000

# Carga de archivos y borrado de archivos indexados desde la consola de
# administracion (F9), apagados por defecto. Habilitarlos EXIGE ADEMAS montar
# el vault en lectura-escritura (ver KB_VAULT_MODO mas abajo) -- sin eso, el
# contenedor no puede escribir ahi y la operacion falla con un error de E/S
# explicito, no en silencio.
KB_INGESTA_CARGA_HABILITADA=false

# Solo lectura por defecto -- decision consciente, no un flag cosmetico (ver
# kb.ingesta.carga-habilitada en application.yml). Ponelo en "rw" junto con
# KB_INGESTA_CARGA_HABILITADA=true de arriba para poder subir y borrar
# archivos desde la consola de administracion.
KB_VAULT_MODO=ro

# ---------------------------------------------------------------------------
# Puertos
# ---------------------------------------------------------------------------
KB_PORT=8080
# Puerto alto a proposito: es comun tener otros Postgres corriendo y un 5432
# ocupado hace fallar el `up` entero. Solo afecta el acceso desde el host
# (DBeaver, psql); dentro de compose la api habla al 5432 del contenedor.
POSTGRES_PORT=55432
# docling-serve (ADR-0010): extrae PDF/DOCX/PPTX para la ingesta de documentos.
DOCLING_SERVE_PORT=5001
# Por defecto (ADR-0014) los documentos se convierten dentro de kb-api, en CPU y
# sin GPU: PDF por OpenDataLoader, DOCX por Apache Tika, PPTX por Apache POI.
# "docling" los manda a docling-serve; para PDF escaneados, el unico con OCR.
# KB_INGESTA_MOTOR_PDF=docling
# KB_INGESTA_MOTOR_OFFICE=docling

# ---------------------------------------------------------------------------
# GPU
# ---------------------------------------------------------------------------
# Nada de esta seccion hace falta en un equipo normal: `make` mira la tarjeta con
# nvidia-smi (la VRAM) y reparte solo. Corre
# `make gpu-check` para ver que detecto, que le dio a la GPU y por que.
#
# Lo que decide, y con que umbral:
#
#   LLM (consultas)            -> GPU siempre que haya tarjeta
#   Embeddings (ingesta+query) -> GPU desde KB_VRAM_EMBEDDINGS_GPU MiB; por debajo
#                                 van a CPU para dejarle la VRAM al LLM (medido
#                                 con gemma3:4b en la T600 de 4 GB; con Granite no
#                                 se remidio)
#   Extraccion PDF (docling)   -> GPU desde KB_VRAM_DOCLING_GPU MiB; el umbral es
#                                 mas alto porque docling-serve no libera su VRAM
#                                 entre conversiones (bug conocido, ver ADR-0010)
#   Reranker                   -> CPU siempre: el proyecto usa la build CPU de
#                                 ONNX Runtime; ninguna variable de aca lo cambia
#
# Todo lo de abajo es para forzar algo distinto de lo que decidiria la deteccion.

# GPU a mano. KB_GPU=1 la fuerza, KB_GPU=0 corre todo en CPU aunque haya tarjeta.
# KB_GPU=1

# docling en GPU a mano, sin esperar al umbral de VRAM.
# KB_DOCLING_GPU=1

# Los umbrales, en MiB, por si mides otra cosa en tu equipo.
# KB_VRAM_EMBEDDINGS_GPU=6144
# KB_VRAM_DOCLING_GPU=8192

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
POSTGRES_DB=baseconocimiento
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb

# ---------------------------------------------------------------------------
# Modelos
# ---------------------------------------------------------------------------
# El LLM y los embeddings los sirven dos instancias de llama-server en el host,
# fuera de Docker (ADR-0017). `make up` las arranca y `make down` las detiene;
# `make llm-estado` dice si responden. Nada de esto hace falta tocarlo.
#
# Un solo modelo de generacion para todo el pipeline: Granite 4.1 3B en Q3_K_M
# del repo oficial de IBM (ADR-0015). Entra entero en 4 GB de VRAM y respondio 9
# de 10 en el smoke10 de eval-100-preguntas. No bajar a la Q2_K del mismo repo:
# entra en bucle de repeticion.
#
# Para probar otro: baja su GGUF a KB_DATA_DIR/models/llm/ y apunta estas dos.
# KB_LLM_GGUF es relativo a KB_DATA_DIR; KB_LLM_MODELO es solo la etiqueta con la
# que responde llama-server (--alias), porque sirve un unico modelo.
# KB_LLM_GGUF=models/llm/granite-4.1-3b-Q3_K_M.gguf
# KB_LLM_MODELO=granite-4.1-3b-Q3_K_M

# Tokens de contexto por consulta y consultas simultaneas. llama-server arranca
# con -c = el producto de los dos (8192), y la api lee el mismo
# KB_LLM_CONTEXTO_TOKENS para saber cuanto texto entra en una pasada.
# KB_LLM_CONTEXTO_TOKENS=4096
# KB_LLM_PARALELO=2

# Puertos de las dos instancias en el host. La api las alcanza por
# host.docker.internal; si los cambias, compose los toma de aqui.
# KB_LLM_PORT=8081
# KB_EMBEDDINGS_PORT=8082

# En Linux, un llama-server en 127.0.0.1 no se ve desde los contenedores:
# hay que arrancarlo en todas las interfaces. En Windows y macOS no hace falta.
# KB_LLAMA_HOST=0.0.0.0

# Embeddings multilingues de 1024 dimensiones (bge-m3, F16). Debe coincidir con
# vector(1024) en la migracion V1: cambiar de modelo exige una migracion nueva.

# Memoria de la JVM como porcentaje de lo que Docker le concede al contenedor.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60

# ---------------------------------------------------------------------------
# Acciones sobre documentos seleccionados (resumir, sintetizar, preguntas,
# ideas, traducir)
# ---------------------------------------------------------------------------
# Cuantos documentos se pueden elegir por accion, cuanto texto en total
# (caracteres) entra al LLM en la llamada final repartido entre ellos, cuanto
# texto entra en cada pasada de lectura de un documento largo (los que no caben
# en su parte se leen enteros por pasadas, nunca recortados), cuanto texto del
# chat se puede traducir de una vez, y cuantas acciones a la vez. Los defaults
# caben en el contexto de 4096 tokens por consulta (KB_LLM_CONTEXTO_TOKENS); con un modelo de
# contexto mas grande sube los dos presupuestos: menos pasadas.
# KB_ACCIONES_MAX_DOCUMENTOS=10
# KB_ACCIONES_MAX_CARACTERES_CONTEXTO=7000
# KB_ACCIONES_MAX_CARACTERES_LECTURA=10000
# KB_ACCIONES_MAX_CARACTERES_TEXTO=8000
# KB_ACCIONES_MAX_CONCURRENTES=2

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Vacio = sin autenticacion (util para la demo local). Con valor, la UI y la API
# exigen la cabecera:  Authorization: Bearer <token>
KB_API_TOKEN=

# ---------------------------------------------------------------------------
# Adaptador de Teams  (deshabilitado por defecto: el producto se demuestra completo sin el)
# ---------------------------------------------------------------------------
KB_TEAMS_HABILITADO=false
# true  = acepta tokens del Bot Framework Emulator (desarrollo local, sin Azure)
# false = exige tokens reales de Bot Framework, con validacion estricta de emisor
KB_TEAMS_EMULATOR=true
KB_TEAMS_APP_ID=
KB_TEAMS_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Conectores externos  (deshabilitados por defecto: exigen credenciales de terceros)
# ---------------------------------------------------------------------------
# Requiere registro de app con permisos de Graph aprobados por un admin del tenant.
KB_GRAPH_HABILITADO=false
KB_GRAPH_TENANT_ID=
KB_GRAPH_CLIENT_ID=
KB_GRAPH_CLIENT_SECRET=
# Un solo canal por ahora: cada canal es su propia fuente (sources.kind='teams_channel').
KB_GRAPH_TEAM_ID=
KB_GRAPH_CHANNEL_ID=

# Requiere un Personal Access Token de Azure DevOps.
KB_AZDO_HABILITADO=false
KB_AZDO_ORG=
KB_AZDO_PROYECTO=
KB_AZDO_PAT=
# Identificador de la wiki a ingerir. Vacio = no ingerir wiki (los work items
# por WIQL igual se ingieren si KB_AZDO_HABILITADO=true).
KB_AZDO_WIKI=
