# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# Todos los valores tienen un default razonable: el producto arranca sin tocar nada.

# ---------------------------------------------------------------------------
# Rutas en disco
# ---------------------------------------------------------------------------
# Donde vive TODO lo pesado y persistente: modelos de Ollama, datos de Postgres
# y el ONNX del reranker. Por defecto queda junto al repo, o sea en D:.
# Esto mantiene C: libre sin depender de configuracion del host.
KB_DATA_DIR=./.data

# El vault: una sola carpeta, FUERA del repositorio, con todo el contenido a
# ingerir. Se monta de solo lectura. Dos subcarpetas fijas debajo de esta raiz
# (crealas si no existen):
#   vault/documentos  -- Markdown, texto, PDF, DOCX, PPTX (estos tres ultimos
#                         via docling-serve, ADR-0010)
#   vault/repos       -- repositorios Git locales a indexar
KB_VAULT_DIR=../../vault

# ---------------------------------------------------------------------------
# Ingesta (F8)
# ---------------------------------------------------------------------------
# Cada cuanto se releva sola KB_CORPUS_DIR/KB_REPOS_DIR/Teams/Azure DevOps, sin
# correr ningun comando. 900000 = 15 min, razonable en uso real. Para ver el
# efecto en un taller/demo, usa un valor bajo -- p. ej. 15000 (15 s):
#   KB_INGESTA_RELEVO_INTERVALO_MS=15000
KB_INGESTA_RELEVO_INTERVALO_MS=900000

# Carga de archivos y borrado de archivos indexados desde la consola de
# administracion (F9), apagados por defecto. Habilitarlos EXIGE ADEMAS montar
# el vault en lectura-escritura (ver KB_VAULT_MODO mas abajo) -- sin eso, el
# contenedor no puede escribir ahi y la operacion falla con un error de E/S
# explicito, no en silencio.
KB_INGESTA_CARGA_HABILITADA=false

# Solo lectura por defecto -- decision consciente, no un flag cosmetico (ver
# kb.ingesta.carga-habilitada en application.yml). Ponelo en "rw" junto con
# KB_INGESTA_CARGA_HABILITADA=true de arriba para poder subir y borrar
# archivos desde la consola de administracion.
KB_VAULT_MODO=ro

# ---------------------------------------------------------------------------
# Puertos
# ---------------------------------------------------------------------------
KB_PORT=8080
# Puerto alto a proposito: es comun tener otros Postgres corriendo y un 5432
# ocupado hace fallar el `up` entero. Solo afecta el acceso desde el host
# (DBeaver, psql); dentro de compose la api habla al 5432 del contenedor.
POSTGRES_PORT=55432
OLLAMA_PORT=11434
# docling-serve (ADR-0010): extrae PDF/DOCX/PPTX para la ingesta de documentos.
DOCLING_SERVE_PORT=5001

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
POSTGRES_DB=baseconocimiento
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb

# ---------------------------------------------------------------------------
# Modelos
# ---------------------------------------------------------------------------
# Un solo modelo de generacion para planner, destilacion y sintesis: con 4 GB de
# VRAM no caben dos residentes, y el intercambio costaria segundos por consulta.
#
# Alternativa evaluada: gemma4:e4b sintetiza mejor (respuestas mas completas,
# cita varias fuentes por afirmacion) pero pesa 9.6 GB contra 3.3 GB de
# gemma3:4b y es ~27% mas lento -- no entra en el presupuesto de 4 GB de VRAM
# del perfil GPU. Si tienes disco/RAM de sobra y no usas ese perfil, probalo:
#   KB_LLM_MODELO=gemma4:e4b
KB_LLM_MODELO=gemma3:4b

# Embeddings multilingues de 1024 dimensiones. Debe coincidir con vector(1024)
# en la migracion V1: cambiar de modelo exige una migracion nueva.
KB_EMBEDDINGS_MODELO=bge-m3

# Mantener los modelos cargados; si no, la primera consulta tras una pausa
# paga la recarga completa.
OLLAMA_KEEP_ALIVE=1h
OLLAMA_NUM_PARALLEL=2

# Memoria de la JVM como porcentaje de lo que Docker le concede al contenedor.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Vacio = sin autenticacion (util para la demo local). Con valor, la UI y la API
# exigen la cabecera:  Authorization: Bearer <token>
KB_API_TOKEN=

# ---------------------------------------------------------------------------
# Adaptador de Teams  (deshabilitado por defecto: el producto se demuestra completo sin el)
# ---------------------------------------------------------------------------
KB_TEAMS_HABILITADO=false
# true  = acepta tokens del Bot Framework Emulator (desarrollo local, sin Azure)
# false = exige tokens reales de Bot Framework, con validacion estricta de emisor
KB_TEAMS_EMULATOR=true
KB_TEAMS_APP_ID=
KB_TEAMS_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Conectores externos  (deshabilitados por defecto: exigen credenciales de terceros)
# ---------------------------------------------------------------------------
# Requiere registro de app con permisos de Graph aprobados por un admin del tenant.
KB_GRAPH_HABILITADO=false
KB_GRAPH_TENANT_ID=
KB_GRAPH_CLIENT_ID=
KB_GRAPH_CLIENT_SECRET=
# Un solo canal por ahora: cada canal es su propia fuente (sources.kind='teams_channel').
KB_GRAPH_TEAM_ID=
KB_GRAPH_CHANNEL_ID=

# Requiere un Personal Access Token de Azure DevOps.
KB_AZDO_HABILITADO=false
KB_AZDO_ORG=
KB_AZDO_PROYECTO=
KB_AZDO_PAT=
# Identificador de la wiki a ingerir. Vacio = no ingerir wiki (los work items
# por WIQL igual se ingieren si KB_AZDO_HABILITADO=true).
KB_AZDO_WIKI=
