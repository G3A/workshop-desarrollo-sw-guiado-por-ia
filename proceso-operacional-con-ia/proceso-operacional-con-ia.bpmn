<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Onboarding" targetNamespace="http://proceso-operacional-con-ia.local/proceso" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Onboarding" name="Desarrollo operacional guiado por IA — sobre GitHub" processRef="Proc_Onboarding" />
    <bpmn:textAnnotation id="Anno_3">
      <bpmn:text>Replanear exige confirmación explícita — es destructivo, descarta el plan actual.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Anno_3_assoc" associationDirection="None" sourceRef="G3" targetRef="Anno_3" />
    <bpmn:textAnnotation id="Anno_2">
      <bpmn:text>Se configura una sola vez por repositorio, no por issue.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Anno_2_assoc" associationDirection="None" sourceRef="pz" targetRef="Anno_2" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Onboarding" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="Lane_dev" name="Persona desarrolladora — local (terminal + editor)">
        <bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fd1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GT2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GUI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>vw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_registry" name="Registro de paquetes (npm público / GitHub Packages)" />
      <bpmn:lane id="Lane_agente" name="Agente de código con IA (skills · subagentes · MCP)">
        <bpmn:flowNodeRef>fd2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>fd3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c4p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>df</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_issues" name="GitHub Issues / Projects">
        <bpmn:flowNodeRef>bi2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bo1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>bo2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_repo" name="GitHub — Pull Requests &#38; Rulesets">
        <bpmn:flowNodeRef>p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>mg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_actions" name="GitHub Actions (CI/CD)">
        <bpmn:flowNodeRef>pz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>pz2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>v0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cd1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start1" name="Empieza el onboarding">
      <bpmn:documentation>Punto de entrada al proceso de onboarding.</bpmn:documentation>
      <bpmn:outgoing>e01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="f0" name="Fundamentos de colaboración">
      <bpmn:documentation>Introduce el ciclo PDCA y las reglas de colaboración humano-IA del equipo.</bpmn:documentation>
      <bpmn:incoming>e01</bpmn:incoming>
      <bpmn:outgoing>e02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="fd1" name="Instalar el agente de IA">
      <bpmn:documentation>Instala el agente de código con IA (CLI o extensión) en el entorno local.</bpmn:documentation>
      <bpmn:incoming>e02</bpmn:incoming>
      <bpmn:outgoing>e03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="fd2" name="Dominar los 4 gestos base">
      <bpmn:documentation>Practica los 4 gestos base: preguntar, generar, revisar, iterar con el agente.</bpmn:documentation>
      <bpmn:incoming>e03</bpmn:incoming>
      <bpmn:outgoing>e04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="fd3" name="Alfabetización de contexto y costo">
      <bpmn:documentation>Aprende a leer el consumo de contexto/tokens y su costo asociado.</bpmn:documentation>
      <bpmn:incoming>e04</bpmn:incoming>
      <bpmn:outgoing>e05</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a1" name="Autenticar GitHub CLI">
      <bpmn:documentation>Autentica el GitHub CLI (gh auth login) contra la cuenta u organización de trabajo.</bpmn:documentation>
      <bpmn:incoming>e05</bpmn:incoming>
      <bpmn:outgoing>e06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="a2" name="Configurar MCP de ejemplo">
      <bpmn:documentation>Configura un servidor MCP de ejemplo para extender las capacidades del agente.</bpmn:documentation>
      <bpmn:incoming>e06</bpmn:incoming>
      <bpmn:incoming>e09</bpmn:incoming>
      <bpmn:outgoing>e07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G1" name="¿Chequeo de salud OK?">
      <bpmn:documentation>Valida que agente, CLI y MCP respondan correctamente antes de continuar.</bpmn:documentation>
      <bpmn:incoming>e07</bpmn:incoming>
      <bpmn:outgoing>e08</bpmn:outgoing>
      <bpmn:outgoing>e09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="¿Existe archivo de contexto?">
      <bpmn:documentation>Verifica si ya existe un archivo de contexto (ej. AGENTS.md) en el repositorio.</bpmn:documentation>
      <bpmn:incoming>e08</bpmn:incoming>
      <bpmn:outgoing>e10</bpmn:outgoing>
      <bpmn:outgoing>e11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="b1" name="Generar contexto del repo">
      <bpmn:documentation>El agente genera desde cero el archivo de contexto del repositorio.</bpmn:documentation>
      <bpmn:incoming>e10</bpmn:incoming>
      <bpmn:outgoing>e12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="bi" name="Completar solo el andamiaje">
      <bpmn:documentation>El agente completa solo las secciones de andamiaje faltantes, sin tocar lo humano.</bpmn:documentation>
      <bpmn:incoming>e11</bpmn:incoming>
      <bpmn:outgoing>e13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b2" name="Completar los TODO humanos">
      <bpmn:documentation>La persona desarrolladora completa las secciones marcadas TODO (criterio humano).</bpmn:documentation>
      <bpmn:incoming>e12</bpmn:incoming>
      <bpmn:incoming>e13</bpmn:incoming>
      <bpmn:outgoing>e14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b3" name="Verificar que llegó el arnés">
      <bpmn:documentation>Confirma que el arnés de pruebas y herramientas quedó operativo localmente.</bpmn:documentation>
      <bpmn:incoming>e14</bpmn:incoming>
      <bpmn:outgoing>e15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="b4" name="Activar hooks locales">
      <bpmn:documentation>Activa hooks locales (pre-commit/pre-push) para obtener feedback temprano.</bpmn:documentation>
      <bpmn:incoming>e15</bpmn:incoming>
      <bpmn:outgoing>e16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pz" name="Configurar el juez de CI">
      <bpmn:documentation>El repo-lead configura el pipeline de CI como juez objetivo de calidad.</bpmn:documentation>
      <bpmn:incoming>e16</bpmn:incoming>
      <bpmn:outgoing>e17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="pz2" name="Disparar la primera corrida">
      <bpmn:documentation>Dispara la primera corrida de CI para validar la configuración recién creada.</bpmn:documentation>
      <bpmn:incoming>e17</bpmn:incoming>
      <bpmn:outgoing>e18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ds" name="Pagar deuda técnica existente">
      <bpmn:documentation>El agente identifica y paga deuda técnica preexistente antes de operar en el repo.</bpmn:documentation>
      <bpmn:incoming>e18</bpmn:incoming>
      <bpmn:outgoing>e19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GT" name="¿Ya existe estrategia de pruebas?">
      <bpmn:documentation>Verifica si ya existe una estrategia de pruebas documentada en el repositorio.</bpmn:documentation>
      <bpmn:incoming>e19</bpmn:incoming>
      <bpmn:outgoing>e20</bpmn:outgoing>
      <bpmn:outgoing>e21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="bt" name="Crear estrategia de pruebas">
      <bpmn:documentation>El agente crea la estrategia de pruebas (pirámide, cobertura objetivo, herramientas).</bpmn:documentation>
      <bpmn:incoming>e21</bpmn:incoming>
      <bpmn:outgoing>e22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GT2" name="¿Aparecieron costuras a producción?">
      <bpmn:documentation>Detecta si aparecieron costuras (seams) necesarias para llevar código a producción.</bpmn:documentation>
      <bpmn:incoming>e20</bpmn:incoming>
      <bpmn:incoming>e22</bpmn:incoming>
      <bpmn:outgoing>e23</bpmn:outgoing>
      <bpmn:outgoing>e24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="bi2" name="Registrar como issue de backlog">
      <bpmn:documentation>Registra la costura detectada como issue de backlog para no perder el hallazgo.</bpmn:documentation>
      <bpmn:incoming>e23</bpmn:incoming>
      <bpmn:outgoing>e25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="bo1" name="Tomar issue del sprint">
      <bpmn:documentation>Se toma el siguiente issue priorizado del sprint desde GitHub Issues/Projects.</bpmn:documentation>
      <bpmn:incoming>e24</bpmn:incoming>
      <bpmn:incoming>e25</bpmn:incoming>
      <bpmn:incoming>e58</bpmn:incoming>
      <bpmn:outgoing>e26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c1" name="Planificar el issue">
      <bpmn:documentation>El agente descompone el issue en un plan de tareas ejecutables.</bpmn:documentation>
      <bpmn:incoming>e26</bpmn:incoming>
      <bpmn:incoming>e30</bpmn:incoming>
      <bpmn:incoming>e31</bpmn:incoming>
      <bpmn:outgoing>e27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="bo2" name="Revisar tareas generadas">
      <bpmn:documentation>Se revisan las tareas generadas por el agente en GitHub Issues/Projects.</bpmn:documentation>
      <bpmn:incoming>e27</bpmn:incoming>
      <bpmn:outgoing>e28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G3" name="¿Aprobación del plan?">
      <bpmn:documentation>Gate humano: aprobar, ajustar o replanear el plan antes de tocar código.</bpmn:documentation>
      <bpmn:incoming>e28</bpmn:incoming>
      <bpmn:outgoing>e29</bpmn:outgoing>
      <bpmn:outgoing>e30</bpmn:outgoing>
      <bpmn:outgoing>e31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c4a" name="Crear rama antes de implementar">
      <bpmn:documentation>Crea la rama de trabajo antes de que el agente empiece a implementar.</bpmn:documentation>
      <bpmn:incoming>e29</bpmn:incoming>
      <bpmn:outgoing>e32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c2" name="Ejecutar tareas, 1 commit c/u">
      <bpmn:documentation>El agente ejecuta las tareas del plan, un commit atómico por tarea.</bpmn:documentation>
      <bpmn:incoming>e32</bpmn:incoming>
      <bpmn:incoming>e41</bpmn:incoming>
      <bpmn:outgoing>e33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GUI" name="¿Necesita verificación visual?">
      <bpmn:documentation>Determina si el cambio tiene una superficie visual que requiera revisión.</bpmn:documentation>
      <bpmn:incoming>e33</bpmn:incoming>
      <bpmn:outgoing>e34</bpmn:outgoing>
      <bpmn:outgoing>e35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="v0" name="Levantar vista previa efímera">
      <bpmn:documentation>GitHub Actions levanta un entorno de vista previa efímero para el PR.</bpmn:documentation>
      <bpmn:incoming>e34</bpmn:incoming>
      <bpmn:outgoing>e36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="vw" name="Verificar visualmente">
      <bpmn:documentation>La persona desarrolladora revisa visualmente el resultado en la vista previa.</bpmn:documentation>
      <bpmn:incoming>e36</bpmn:incoming>
      <bpmn:outgoing>e37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c3" name="Verificación en 4 capas">
      <bpmn:documentation>Verificación en las 4 capas: unidad, contrato, integración y aceptación.</bpmn:documentation>
      <bpmn:incoming>e35</bpmn:incoming>
      <bpmn:incoming>e37</bpmn:incoming>
      <bpmn:outgoing>e38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G4" name="¿Criterios de aceptación OK?">
      <bpmn:documentation>Gate: los criterios de aceptación se cumplieron en la verificación de 4 capas.</bpmn:documentation>
      <bpmn:incoming>e38</bpmn:incoming>
      <bpmn:outgoing>e39</bpmn:outgoing>
      <bpmn:outgoing>e40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="c4p" name="Replanear la tarea fallida">
      <bpmn:documentation>El agente replanea la tarea que falló para volver a ejecutarla.</bpmn:documentation>
      <bpmn:incoming>e40</bpmn:incoming>
      <bpmn:outgoing>e41</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c4b" name="Commit con pie Closes #N">
      <bpmn:documentation>Commit final con pie 'Closes #N' para enlazar el commit con el issue de GitHub.</bpmn:documentation>
      <bpmn:incoming>e39</bpmn:incoming>
      <bpmn:outgoing>e42</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c4c" name="Push de la rama">
      <bpmn:documentation>Push de la rama de trabajo al remoto en GitHub.</bpmn:documentation>
      <bpmn:incoming>e42</bpmn:incoming>
      <bpmn:outgoing>e43</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="p1" name="Abrir Pull Request">
      <bpmn:documentation>Se abre el Pull Request en GitHub.</bpmn:documentation>
      <bpmn:incoming>e43</bpmn:incoming>
      <bpmn:incoming>e47</bpmn:incoming>
      <bpmn:outgoing>e44</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G5" name="¿CI en verde?">
      <bpmn:documentation>Gate: los checks de CI configurados en el PR están en verde.</bpmn:documentation>
      <bpmn:incoming>e44</bpmn:incoming>
      <bpmn:outgoing>e45</bpmn:outgoing>
      <bpmn:outgoing>e46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="pf" name="Arreglar y repushear">
      <bpmn:documentation>El agente diagnostica el fallo de CI y hace un repush con la corrección.</bpmn:documentation>
      <bpmn:incoming>e46</bpmn:incoming>
      <bpmn:outgoing>e47</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cr" name="Revisión de código (agente + CODEOWNERS)">
      <bpmn:documentation>Revisión de código combinada: primera pasada del agente + CODEOWNERS humano.</bpmn:documentation>
      <bpmn:incoming>e45</bpmn:incoming>
      <bpmn:incoming>e51</bpmn:incoming>
      <bpmn:outgoing>e48</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G6" name="¿PR aprobada?">
      <bpmn:documentation>Gate: la Pull Request fue aprobada según el Ruleset del repositorio.</bpmn:documentation>
      <bpmn:incoming>e48</bpmn:incoming>
      <bpmn:outgoing>e49</bpmn:outgoing>
      <bpmn:outgoing>e50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ac" name="Atender comentarios">
      <bpmn:documentation>La persona desarrolladora atiende los comentarios de la revisión.</bpmn:documentation>
      <bpmn:incoming>e50</bpmn:incoming>
      <bpmn:outgoing>e51</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="mg" name="Merge (Rulesets exige checks)">
      <bpmn:documentation>Merge del PR; los Rulesets de GitHub exigen que los checks estén en verde.</bpmn:documentation>
      <bpmn:incoming>e49</bpmn:incoming>
      <bpmn:outgoing>e52</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="cd1" name="CD automático a staging">
      <bpmn:documentation>GitHub Actions despliega automáticamente a staging tras el merge.</bpmn:documentation>
      <bpmn:incoming>e52</bpmn:incoming>
      <bpmn:incoming>e56</bpmn:incoming>
      <bpmn:outgoing>e53</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G8" name="¿CD en verde?">
      <bpmn:documentation>Gate: el despliegue continuo a staging terminó en verde.</bpmn:documentation>
      <bpmn:incoming>e53</bpmn:incoming>
      <bpmn:outgoing>e54</bpmn:outgoing>
      <bpmn:outgoing>e55</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="df" name="Arreglar hacia adelante">
      <bpmn:documentation>El agente arregla hacia adelante (fix-forward) el problema detectado en CD.</bpmn:documentation>
      <bpmn:incoming>e55</bpmn:incoming>
      <bpmn:outgoing>e56</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="c5" name="Retrospectiva">
      <bpmn:documentation>El agente arma una retrospectiva breve del issue recién cerrado.</bpmn:documentation>
      <bpmn:incoming>e54</bpmn:incoming>
      <bpmn:outgoing>e57</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G7" name="¿Quedan issues del sprint?">
      <bpmn:documentation>Chequea si quedan issues pendientes del sprint actual.</bpmn:documentation>
      <bpmn:incoming>e57</bpmn:incoming>
      <bpmn:outgoing>e58</bpmn:outgoing>
      <bpmn:outgoing>e59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_ok" name="Sprint cerrado">
      <bpmn:documentation>Cierre del sprint: no quedan issues pendientes en el ciclo PDCA.</bpmn:documentation>
      <bpmn:incoming>e59</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="e01" sourceRef="start1" targetRef="f0" />
    <bpmn:sequenceFlow id="e02" sourceRef="f0" targetRef="fd1" />
    <bpmn:sequenceFlow id="e03" sourceRef="fd1" targetRef="fd2" />
    <bpmn:sequenceFlow id="e04" sourceRef="fd2" targetRef="fd3" />
    <bpmn:sequenceFlow id="e05" sourceRef="fd3" targetRef="a1" />
    <bpmn:sequenceFlow id="e06" sourceRef="a1" targetRef="a2" />
    <bpmn:sequenceFlow id="e07" sourceRef="a2" targetRef="G1" />
    <bpmn:sequenceFlow id="e08" name="Sí" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="e09" name="No" sourceRef="G1" targetRef="a2" />
    <bpmn:sequenceFlow id="e10" name="No" sourceRef="G2" targetRef="b1" />
