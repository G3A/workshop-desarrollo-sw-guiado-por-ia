# Placeholders: none.
#
# Hook 7 — generated-file guard. PreToolUse, matcher "Edit|Write|MultiEdit".
# Denies hand-editing a migration file that has already been applied.
#
# INSTALL EACH BRANCH ONLY WHEN ITS ARTIFACT EXISTS. The Flyway branch needs
# src/main/resources/db/migration/ in the repo; the Liquibase branch needs a changelog directory.
# Neither depends on the deterministic instrumentation having run — it depends on the directory
# being there. Phase 1 decides; delete the branch that does not apply and say so in the report.
#
# WHY THIS DOES NOT BLOCK EVERY WRITE, UNLIKE THE .NET SIBLING'S Migrations/ GUARD: EF Core
# migrations are generated by a tool (`dotnet ef migrations add`), so hand-writing one is always
# wrong. Flyway and Liquibase migrations are normally HAND-WRITTEN SQL (or changelog XML/YAML) —
# creating the next one is the expected, correct workflow. What must never happen is editing one
# that already exists: once applied, both tools checksum the script, and a hand-edit desyncs the
# checksum from what actually ran, failing validation on the next deploy with an error that points
# at a checksum mismatch rather than at the edit. So the check is existence-based: `Edit` and
# `MultiEdit` always target an existing file, so they are always denied under these paths; `Write`
# is denied only when it would overwrite a file already on disk — a `Write` to a brand-new path
# (the next version number) goes through.
#
# ---8<--- everything above this line is instructions for you; delete it ---8<---
#!/usr/bin/env bash
# `set -u` only. See the note in secret-read-guard.sh.
set -u

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/_lib.sh"

hook_read_stdin

FILE="$(json_path file_path)"
[ -z "$FILE" ] && exit 0

# Flyway owns src/main/resources/db/migration/ once a script has run. Segment-anchored so
# db/migrations-guide.md and a class named MigrationHelper.java are untouched.
case "$FILE" in
  */src/main/resources/db/migration/*|src/main/resources/db/migration/*)
    if [ -f "$FILE" ]; then
      hook_deny 'Blocked: files under src/main/resources/db/migration/ are checksummed by Flyway once applied. Do not edit an existing migration — add the next V<n>__description.sql instead.'
    fi
    ;;
esac

# Liquibase's changelog directory, only present when the team uses it. Same reasoning: a
# changelog entry is checksummed once it has run.
case "$FILE" in
  */src/main/resources/db/changelog/*|src/main/resources/db/changelog/*)
    if [ -f "$FILE" ]; then
      hook_deny 'Blocked: files under src/main/resources/db/changelog/ are checksummed by Liquibase once applied. Do not edit an existing changelog entry — add a new one instead.'
    fi
    ;;
esac

exit 0
