# Placeholders:
#   {{POM_PATH}}  — the pom.xml `mvn -f` should build against, relative to the repo root, e.g.
#                   `pom.xml` or `base-conocimiento/pom.xml` in a monorepo where the Java project
#                   lives in a subfolder. Take it from the repo; never assume the repo root.
#
# Hook 2 — format on edit. PostToolUse, matcher "Edit|Write|MultiEdit".
#
# WHY IT IS SCOPED TO ONE FILE AND DOES NOT CALL `make format` / `mvn spotless:apply` bare:
# An unscoped `spotless:apply` rewrites every file in the module. That is right for a human before
# a commit and wrong here: tens of seconds, files the agent never touched, on EVERY edit. Scoped
# with -DspotlessFiles it is a second or two and the diff stays honest. This is the one place in
# this catalogue where a Makefile target may exist (`make format`) and is deliberately not used.
# Say so in the report, or the next reader will "fix" it.
#
# WHY THE PATTERN IS ".*" PLUS AN ESCAPED RELATIVE PATH, NOT THE ABSOLUTE PATH ITSELF:
# `-DspotlessFiles` is matched with Java's String#matches against the file's ABSOLUTE path — read
# from the plugin's own README, not assumed. Reproducing that absolute path exactly (drive letter,
# separator style) is not reliable across Maven/JVM versions on Windows. Instead: escape the
# file's path RELATIVE to the repo root, turn every "/" into a character class that matches either
# separator ("[/\\]"), and prefix ".*". String#matches requires a FULL match, so ".*<suffix>" is
# sufficient and never depends on how Maven spells the absolute prefix.
#
# WHY IT STILL NEEDS A pom.xml: -f {{POM_PATH}} tells Maven which project (and therefore which
# spotless-maven-plugin configuration) to load. Do NOT "correct" this to always be the repo root —
# in a monorepo the Java project can live in a subfolder, exactly as it does in this one.
#
# WHY IT NEVER BLOCKS: PostToolUse runs after the tool succeeded; there is nothing left to stop.
# The common failure is real and boring: the file does not compile yet because the agent is
# mid-refactor. Blocking on that would fight the agent instead of helping it.
#
# PRECONDITION, CHECKED IN PHASE 1, NOT HERE: spotless-maven-plugin must already be declared in
# the pom (build plugin or pluginManagement). Without it there is no formatter configuration to
# run, the same way the hook is only offered where an .editorconfig exists in the .NET sibling.
#
# ---8<--- everything above this line is instructions for you; delete it ---8<---
#!/usr/bin/env bash
# `set -u` only. See the note in secret-read-guard.sh: pipefail turns a short-circuiting filter
# into a silent failure.
set -u

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/_lib.sh"

hook_read_stdin

FILE="$(json_path file_path)"
[ -z "$FILE" ] && exit 0

# Java only. Spotless has nothing to say about .md, .xml or .properties in the common
# configuration, and calling Maven for those pays the JVM+reactor startup cost for no change.
case "$FILE" in
  *.java) ;;
  *) exit 0 ;;
esac

# Resolve BOTH paths physically before comparing them. `git rev-parse` and the payload can spell
# the same directory differently, and a textual strip then leaves REL unchanged, so the hook exits
# 0 having formatted nothing. A hook that silently does nothing passes every check in Phase 5.
ROOT="$(cd "$(repo_root)" 2>/dev/null && pwd -P)" || exit 0
FDIR="$(cd "$(dirname "$FILE")" 2>/dev/null && pwd -P)" || exit 0   # also covers a deleted file
FILE="$FDIR/$(basename "$FILE")"

cd "$ROOT" || exit 0

# Quoting "$ROOT" inside ${...#} turns off pattern matching, so a repo path containing [ ] * or ?
# is stripped literally instead of being read as a glob.
case "$FILE" in
  "$ROOT"/*) REL="${FILE#"$ROOT"/}" ;;
  *) exit 0 ;;                    # outside this repo; not ours to format
esac

[ -f "$REL" ] || exit 0

# Regex-escape the relative path, then make every separator tolerant of the platform Maven
# actually sees. Order matters: escape metacharacters FIRST so the "/" substitution in the second
# pass is not itself re-escaped by the first.
ESCAPED="$(printf '%s' "$REL" \
  | sed -E 's/[.\+*?^$(){}|]/\\&/g' \
  | sed -E 's,/,[/\\\\],g')"

OUT="$(mvn -q -f "{{POM_PATH}}" spotless:apply "-DspotlessFiles=.*${ESCAPED}" 2>&1)"
STATUS=$?

if [ $STATUS -ne 0 ]; then
  # stderr on a PostToolUse hook is shown, not acted on. Keep it to a few lines: the whole point
  # is that somebody notices the formatter is broken, not that they read a full Maven log here.
  printf 'format-on-edit: mvn spotless:apply exited %s for %s\n' "$STATUS" "$REL" >&2
  printf '%s\n' "$OUT" | head -n 5 >&2
fi

exit 0
