// TEMPLATE — ruleset for the INTEGRATION branch (the one every work branch targets).
//
// PLACEHOLDERS
//   <RULESET-NAME>        e.g. integration-dev
//   <INTEGRATION-BRANCH>  bare branch name; it goes inside a FULL ref below
//   <CHECK-CONTEXT>       the JOB NAME from a completed run, read with:
//                           gh api repos/{owner}/{repo}/commits/{sha}/check-runs --jq .check_runs[].name
//                         NOT the workflow file name and NOT the workflow's `name:`.
//
// DECISIONS THIS TEMPLATE ENCODES
//   allowed_merge_methods = squash  -> the history reads one commit per PR.
//   strict_required_status_checks_policy = true -> the branch must be up to date before merging.
//     This is correct HERE and wrong on a release branch; see references/ruleset-anatomy.md.
//   bypass_actors = []  -> no holes by default. Add the Admin role ONLY for a single-person repo
//     that needs required_approving_review_count = 1, say why, and record when it gets removed.
//
// BEFORE WRITING: delete every // comment line — the API rejects a body that is not strict JSON.
// APPLY: gh api repos/{owner}/{repo}/rulesets --method POST --input <this file>
{
  "name": "<RULESET-NAME>",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/<INTEGRATION-BRANCH>"],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "allowed_merge_methods": ["squash"],
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "required_review_thread_resolution": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": true,
        "required_reviewers": []
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [{ "context": "<CHECK-CONTEXT>" }],
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false
      }
    }
  ]
}
