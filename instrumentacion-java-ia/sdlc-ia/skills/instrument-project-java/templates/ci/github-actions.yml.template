# Written to `.github/workflows/ci.yml`.
#
# Placeholders — resolve once, when the file is written, never copied from this template:
#
#   {{CHECKOUT_MAJOR}}       {{SETUP_JAVA_MAJOR}}       {{CACHE_MAJOR}}      {{UPLOAD_ARTIFACT_MAJOR}}
#   {{CODEQL_MAJOR}}         github/codeql-action  -- only if control 11c is installed
#   {{CLAUDE_ACTION_MAJOR}}  anthropics/claude-code-action -- only if control 9b is installed
#                            control 13 needs NO action placeholder: it runs the Maven scanner via
#                            `make sonar`, whose version is pinned in pom.xml, not here.
#   {{JAVA_VERSION}}         the repo's own <java.version> / <maven.compiler.release>, never guessed
#   {{GITLEAKS_VERSION}}     gh release view --repo gitleaks/gitleaks --json tagName --jq .tagName
#                            prints e.g. v8.30.1 -- write it WITHOUT the leading v (8.30.1): the URL
#                            below adds the v itself and the archive name has none.
#
#   Action majors, one gh call each, same in PowerShell 5.1, 7 and bash (no quotes inside --jq --
#   Windows PowerShell 5.1 strips them before gh sees them):
#     gh api repos/actions/checkout/releases/latest --jq .tag_name
#   prints e.g. v4.2.1 -- write the major, v4. Likewise for actions/setup-java, actions/cache,
#   actions/upload-artifact. You are resolving once, by hand, at install time; read the value,
#   do not script the substring.
#
# Two lines carry the whole design:
#   java-version: {{JAVA_VERSION}}   the runner installs the JDK the repo targets. Same version
#                                     everywhere -- read it from pom.xml, not from this file.
#   make ci                          one definition of "the code is fine". Restating the steps here
#                                     guarantees drift the first time someone adds a check to the
#                                     Makefile.
#
# actions/setup-java's own `cache: maven` handles the ~/.m2 cache -- no separate actions/cache step
# needed for Maven (unlike the .NET sibling template, which caches NuGet by hand). Keep it that way;
# a hand-rolled cache step next to setup-java's built-in one just doubles the work for the same key.
#
# ubuntu-latest ships `make`. Windows runners do not -- if the team ever needs a Windows job, `make`
# has to be installed first (choco install make).
# Delete this header before writing the file.

name: CI

on:
  # Every branch, every push. A gate that only runs on main tells the team about breakage after it
  # is already shared; on a feature branch it tells the person who wrote it, while they still have
  # the context.
  push:
  # Adds pull requests opened from forks, whose commits never triggered the push event above.
  pull_request:

# One run per branch. A second push cancels the first instead of queueing behind it.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    # Without this, every pull request inside this repository runs twice: once for the push to its
    # branch and once for the pull_request event. Fork PRs still run -- their push never reached
    # this repository.
    if: >-
      github.event_name == 'push' ||
      github.event.pull_request.head.repo.full_name != github.repository
    runs-on: ubuntu-latest

    steps:
      # gitleaks scans history, so it needs the full clone.
      # Drop fetch-depth if secret scanning was skipped in Phase 2.
      - uses: actions/checkout@{{CHECKOUT_MAJOR}}
        with:
          fetch-depth: 0

      # Puts the binary on PATH so `make ci` can run the single scan the Makefile defines.
      # Deliberately NOT gitleaks/gitleaks-action: that action runs its own scan instead of exposing
      # the binary, and it requires a licence key for organisation-owned repos.
      # Drop this step if secret scanning was skipped.
      #
      # {{GITLEAKS_VERSION}} is RESOLVED AT INSTALL TIME, not written by hand -- see the placeholder
      # list above. This is what "never hardcode a version" means here: resolve it from the source
      # of truth when the file is written, then PIN it. It does NOT mean re-resolving on every CI
      # run -- a pipeline that fetches "latest" runs a different binary tomorrow than it ran today,
      # with nothing recording the change, and a compromised or broken release lands straight in the
      # gate meant to catch problems. Bump it the way you bump any other dependency.
      - name: Install gitleaks
        env:
          GITLEAKS_VERSION: "{{GITLEAKS_VERSION}}"
        run: |
          set -euo pipefail
          BASE="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}"
          ARCHIVE="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
          cd "$(mktemp -d)"
          curl -fsSL -o "$ARCHIVE" "$BASE/$ARCHIVE"
          curl -fsSL -o checksums.txt "$BASE/gitleaks_${GITLEAKS_VERSION}_checksums.txt"
          # Verify before extracting. Without this the pin only says which URL was fetched, not
          # what came back from it.
          grep " ${ARCHIVE}\$" checksums.txt | sha256sum -c -
          # No sudo: a writable directory on PATH is enough.
          mkdir -p "$HOME/.local/bin"
          tar -xzf "$ARCHIVE" -C "$HOME/.local/bin" gitleaks
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
          "$HOME/.local/bin/gitleaks" version

      - name: Install JDK and Maven wrapper cache
        uses: actions/setup-java@{{SETUP_JAVA_MAJOR}}
        with:
          distribution: temurin
          java-version: "{{JAVA_VERSION}}"
          cache: maven

      # Control 9. Dependency-check keeps its NVD mirror in the dataDirectory the pom.xml points at
      # (~/.cache/dependency-check -- outside ~/.m2 on purpose, so setup-java's pom-keyed Maven
      # cache never carries it). Without this step every run rebuilds the mirror: 20+ minutes
      # without an NVD key. The key is unique per run so the refreshed mirror is saved every time;
      # restore-keys picks up the most recent previous one.
      # Drop this step, and the NVD_API_KEY line below, if SCA was skipped in Phase 3.
      - name: Cache the NVD mirror for dependency-check
        uses: actions/cache@{{CACHE_MAJOR}}
        with:
          path: ~/.cache/dependency-check
          key: nvd-${{ runner.os }}-${{ github.run_id }}
          restore-keys: nvd-${{ runner.os }}-

      - name: Run the same gates as local
        env:
          # Repository secret (Settings > Secrets and variables > Actions). Unset = the scan still
          # runs, throttled. Never a literal here.
          NVD_API_KEY: ${{ secrets.NVD_API_KEY }}
        run: make ci

      # Only useful once Surefire/Failsafe reports exist under target/surefire-reports -- which
      # `make test` already produces via the maven-surefire-plugin. Delete this step only if the
      # repo suppresses those reports.
      - name: Publish test results
        if: always()
        uses: actions/upload-artifact@{{UPLOAD_ARTIFACT_MAJOR}}
        with:
          name: test-results
          path: "**/target/surefire-reports/**"
          if-no-files-found: ignore

  # ── CodeQL — control 11c. DELETE THIS JOB IF CONTROL 11 WAS DECLINED. ──────────────────────
  # It is the half FindSecBugs cannot keep up with: FindSecBugs runs locally and is portable,
  # CodeQL is maintained continuously by GitHub. Each covers the other's blind spot, which is why
  # both are installed or neither is.
  #
  # COST, CHECKED BEFORE WRITING THIS JOB: free on PUBLIC repositories; on a PRIVATE one it needs
  # GitHub Advanced Security, which is PAID. On a private repo without it, delete this job, install
  # FindSecBugs alone, and say so — never let the user find the cost on a billing page.
  #
  # Its own job and not part of `make ci` on purpose: it is a GitHub-hosted analysis, and the make
  # targets stay runnable on a laptop.
  codeql:
    if: >-
      github.event_name == 'push' ||
      github.event.pull_request.head.repo.full_name != github.repository
    runs-on: ubuntu-latest
    permissions:
      # security-events: write is what lets the results reach the Security tab. Without it the
      # analysis runs and the findings go nowhere, which is the silent half-install this whole
      # skill is written against.
      security-events: write
      contents: read
      actions: read
    steps:
      - uses: actions/checkout@{{CHECKOUT_MAJOR}}

      - name: Initialize CodeQL
        uses: github/codeql-action/init@{{CODEQL_MAJOR}}
        with:
          languages: java-kotlin
          # security-extended adds the lower-confidence security queries. Start here; drop to the
          # default suite if the noise is not being triaged.
          queries: security-extended

      # CodeQL needs the compiled bytecode. `make build` rather than a bare mvn call, so it uses
      # the same definition of "build" as everything else here.
      - name: Build
        run: make build

      - name: Analyze
        uses: github/codeql-action/analyze@{{CODEQL_MAJOR}}

  # ── AI review — control 9b. DELETE THIS JOB IF IT WAS DECLINED. ───────────────────────────────
  # The half you cannot skip. github-plan-build already runs /code-review locally before opening
  # the PR; this one runs whether or not anyone remembered.
  #
  # DO NOT REQUIRE THIS CHECK IN THE RULESET, and say why in the report: a non-deterministic
  # reviewer with veto power blocks correct pull requests on a model's judgement, and the team
  # learns to ignore it or to ask for a bypass. Deterministic sensors and human approval block;
  # this contributes signal, not a verdict.
  #
  # NEEDS the ANTHROPIC_API_KEY repository secret. Without it the job fails on every PR — that is
  # deliberate and visible, rather than skipping silently and looking installed.
  revision-ia:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
    steps:
      - uses: actions/checkout@{{CHECKOUT_MAJOR}}
        with:
          fetch-depth: 0

      - name: Revisión por IA
        uses: anthropics/claude-code-action@{{CLAUDE_ACTION_MAJOR}}
        with:
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}

  # ── SonarQube quality gate — control 13. DELETE THIS JOB IF IT WAS DECLINED. ──────────────────
  # This skill NEVER stands a SonarQube server up. The job assumes one the team already runs, named
  # by the SONAR_HOST_URL repository variable. No server = control 13 reported out of scope.
  #
  # Its own job, and NOT part of `make ci`, for one reason: `make ci` has to run on any laptop with
  # no credentials, and this needs a host and a token that are per-environment. That is the same
  # shape as the codeql job above — and the opposite conclusion about the Ruleset:
  #
  #   REQUIRE THIS CHECK. Unlike codeql (a queue of findings to triage) and revision-ia (a model's
  #   judgement), this is a pass/fail verdict against a bar the team set itself on the server. That
  #   is exactly what a required check is for. /sdlc-ia:instrument-github-repo writes it.
  #
  # For a Maven project use the MAVEN SCANNER, as here — not SonarSource/sonarqube-scan-action.
  # SonarSource's own documentation says so: the CLI action does not see the module graph, the test
  # sources or the compiled bytecode, and silently analyses less.
  sonar:
    if: >-
      github.event_name == 'push' ||
      github.event.pull_request.head.repo.full_name != github.repository
    runs-on: ubuntu-latest
    steps:
      # fetch-depth: 0 is NOT optional here. Sonar decides what counts as new code from the
      # history, and the quality gate is evaluated on new code -- a shallow clone degrades both.
      - uses: actions/checkout@{{CHECKOUT_MAJOR}}
        with:
          fetch-depth: 0

      # The scanner itself needs Java 21+ to RUN (since 2026-07-20 nothing lower is supported).
      # Since scanner 5.0 it provisions a JDK 21 on its own, so {{JAVA_VERSION}} can be lower and
      # the repo still analyses -- but that provisioning DOWNLOADS a JRE, which fails on a runner
      # with no outbound internet. There, pin this to 21+ and add
      # -Dsonar.scanner.skipJreProvisioning=true to the make target.
      - name: Install JDK and Maven wrapper cache
        uses: actions/setup-java@{{SETUP_JAVA_MAJOR}}
        with:
          distribution: temurin
          java-version: "{{JAVA_VERSION}}"
          cache: maven

      - name: Cache the SonarQube analysis cache
        uses: actions/cache@{{CACHE_MAJOR}}
        with:
          path: ~/.sonar/cache
          key: sonar-${{ runner.os }}
          restore-keys: sonar-${{ runner.os }}

      - name: Analyze and wait for the quality gate
        env:
          # Repository SECRET -- never a literal, never an input to the workflow.
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          # Repository VARIABLE (Settings > Secrets and variables > Actions > Variables). The host
          # is not a secret, and keeping it a variable means it shows in the log when it is wrong.
          SONAR_HOST_URL: ${{ vars.SONAR_HOST_URL }}
        # The make target carries -Dsonar.qualitygate.wait=true. WITHOUT that flag this step
        # uploads the analysis and exits GREEN even when the gate failed -- a dashboard, not a
        # gate. Do not "simplify" it away.
        run: make sonar

# Branch protection is what turns `check` from a report into a gate, and
# `/sdlc-ia:instrument-github-repo` is what writes it — a Ruleset requiring the `check` status
# check and an approving review. Until that runs, everything above reports and nothing blocks.
#
# REQUIRE `check`, and REQUIRE `sonar` when control 13 is installed. Do NOT require `codeql` unless
# the team agreed to triage its findings on every PR, and do NOT require `revision-ia` at all — see
# their comments above. The line between the two groups is not how good the tool is: it is whether
# the job produces a verdict against a bar the team set (required) or a queue of findings somebody
# still has to judge (not required).
#
# Do NOT add paths-ignore to skip docs-only commits once `check` is a required status check: the
# skipped run never reports, and the pull request waits for a check that will never arrive.
