# Written to `.github/workflows/ci.yml`.
#
# Placeholders — resolve once, when the file is written, never copied from this template:
#
#   {{CHECKOUT_MAJOR}}       {{SETUP_JAVA_MAJOR}}       {{CACHE_MAJOR}}      {{UPLOAD_ARTIFACT_MAJOR}}
#   {{JAVA_VERSION}}         the repo's own <java.version> / <maven.compiler.release>, never guessed
#   {{GITLEAKS_VERSION}}     gh release view --repo gitleaks/gitleaks --json tagName --jq '.tagName' | tr -d v
#
#   for a in actions/checkout actions/setup-java actions/cache actions/upload-artifact; do
#     printf '%s %s\n' "$a" "$(gh api repos/$a/releases/latest --jq .tag_name | cut -d. -f1)"
#   done
#
# Two lines carry the whole design:
#   java-version: {{JAVA_VERSION}}   the runner installs the JDK the repo targets. Same version
#                                     everywhere -- read it from pom.xml, not from this file.
#   make ci                          one definition of "the code is fine". Restating the steps here
#                                     guarantees drift the first time someone adds a check to the
#                                     Makefile.
#
# actions/setup-java's own `cache: maven` handles the ~/.m2 cache -- no separate actions/cache step
# needed for Maven (unlike the .NET sibling template, which caches NuGet by hand). Keep it that way;
# a hand-rolled cache step next to setup-java's built-in one just doubles the work for the same key.
#
# ubuntu-latest ships `make`. Windows runners do not -- if the team ever needs a Windows job, `make`
# has to be installed first (choco install make).
# Delete this header before writing the file.

name: CI

on:
  # Every branch, every push. A gate that only runs on main tells the team about breakage after it
  # is already shared; on a feature branch it tells the person who wrote it, while they still have
  # the context.
  push:
  # Adds pull requests opened from forks, whose commits never triggered the push event above.
  pull_request:

# One run per branch. A second push cancels the first instead of queueing behind it.
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    # Without this, every pull request inside this repository runs twice: once for the push to its
    # branch and once for the pull_request event. Fork PRs still run -- their push never reached
    # this repository.
    if: >-
      github.event_name == 'push' ||
      github.event.pull_request.head.repo.full_name != github.repository
    runs-on: ubuntu-latest

    steps:
      # gitleaks scans history, so it needs the full clone.
      # Drop fetch-depth if secret scanning was skipped in Phase 2.
      - uses: actions/checkout@{{CHECKOUT_MAJOR}}
        with:
          fetch-depth: 0

      # Puts the binary on PATH so `make ci` can run the single scan the Makefile defines.
      # Deliberately NOT gitleaks/gitleaks-action: that action runs its own scan instead of exposing
      # the binary, and it requires a licence key for organisation-owned repos.
      # Drop this step if secret scanning was skipped.
      #
      # {{GITLEAKS_VERSION}} is RESOLVED AT INSTALL TIME, not written by hand -- see the placeholder
      # list above. This is what "never hardcode a version" means here: resolve it from the source
      # of truth when the file is written, then PIN it. It does NOT mean re-resolving on every CI
      # run -- a pipeline that fetches "latest" runs a different binary tomorrow than it ran today,
      # with nothing recording the change, and a compromised or broken release lands straight in the
      # gate meant to catch problems. Bump it the way you bump any other dependency.
      - name: Install gitleaks
        env:
          GITLEAKS_VERSION: "{{GITLEAKS_VERSION}}"
        run: |
          set -euo pipefail
          BASE="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}"
          ARCHIVE="gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
          cd "$(mktemp -d)"
          curl -fsSL -o "$ARCHIVE" "$BASE/$ARCHIVE"
          curl -fsSL -o checksums.txt "$BASE/gitleaks_${GITLEAKS_VERSION}_checksums.txt"
          # Verify before extracting. Without this the pin only says which URL was fetched, not
          # what came back from it.
          grep " ${ARCHIVE}\$" checksums.txt | sha256sum -c -
          # No sudo: a writable directory on PATH is enough.
          mkdir -p "$HOME/.local/bin"
          tar -xzf "$ARCHIVE" -C "$HOME/.local/bin" gitleaks
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
          "$HOME/.local/bin/gitleaks" version

      - name: Install JDK and Maven wrapper cache
        uses: actions/setup-java@{{SETUP_JAVA_MAJOR}}
        with:
          distribution: temurin
          java-version: "{{JAVA_VERSION}}"
          cache: maven

      - name: Run the same gates as local
        run: make ci

      # Only useful once Surefire/Failsafe reports exist under target/surefire-reports -- which
      # `make test` already produces via the maven-surefire-plugin. Delete this step only if the
      # repo suppresses those reports.
      - name: Publish test results
        if: always()
        uses: actions/upload-artifact@{{UPLOAD_ARTIFACT_MAJOR}}
        with:
          name: test-results
          path: "**/target/surefire-reports/**"
          if-no-files-found: ignore

# Branch protection is what turns this from a report into a gate:
# Settings > Branches > require the `check` status check before merging.
#
# Do NOT add paths-ignore to skip docs-only commits once `check` is a required status check: the
# skipped run never reports, and the pull request waits for a check that will never arrive.
